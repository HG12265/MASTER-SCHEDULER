# Master Scheduler — Backend Environment Configuration

# Database Settings
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=master_scheduler

# Environment & Timezone
APP_ENV=development
APP_TIMEZONE=UTC
LOG_LEVEL=INFO

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_64_char_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Upload Limits & Backups
MAX_UPLOAD_SIZE_MB=25

# SMTP Email Settings (Optional / Configurable)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@masterscheduler.edu
